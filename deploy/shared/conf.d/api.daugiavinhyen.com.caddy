api.daugiavinhyen.com {
	encode zstd gzip

	# The API enforces per-route limits too; this stops oversized bodies at the edge.
	request_body {
		max_size 60MB
	}

	# Static privacy page for the Hermes assistant (Google OAuth verification).
	handle /privacy {
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><html lang=en><head><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>Hermes Assistant Privacy Policy</title></head><body style='font-family:system-ui,sans-serif;max-width:640px;margin:40px auto;padding:0 16px;line-height:1.6'><h1>Privacy Policy — Hermes Assistant</h1><p>Hermes Assistant is a private, single-user personal assistant operated by its owner for their own personal use only. No other users are onboarded.</p><p>It accesses the owner's own Google account data (Gmail, Calendar, Drive, Sheets, Docs and Contacts) solely to carry out the owner's own requests made through a private Telegram chat. This data is never sold, never shared with third parties, and never used for advertising, profiling, or any purpose other than fulfilling the owner's direct requests.</p><p>Data is processed on a private server controlled by the owner and is not disclosed to anyone else. Google user data is retained only as long as needed to serve the owner's requests and can be revoked at any time from the Google Account permissions page.</p><p>Contact: tthandb@gmail.com. Last updated: 2026-09-05.</p></body></html>" 200
	}

	handle {
		reverse_proxy daugia-api:8080 {
			# The API trusts only X-Real-IP for rate limiting, so it must be set here
			# from the actual peer and never passed through from the client.
			header_up X-Real-IP {remote_host}
			header_up -True-Client-IP
		}
	}

	log {
		output file /data/access-daugia.log {
			roll_size 50mb
			roll_keep 5
		}
	}
}
