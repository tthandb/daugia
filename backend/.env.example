DATABASE_URL=postgres://postgres:password@localhost:5432/daugia?sslmode=disable
# At least 32 random characters; the server refuses placeholder values.
# Generate with: openssl rand -base64 48
JWT_SECRET=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=articles
MINIO_USE_SSL=false
CORS_ORIGIN=http://localhost:3000
SECURE_COOKIE=false
PORT=8080
# Only needed for `go run ./cmd/api seed` (min 12 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Only needed for `go run ./cmd/api migrate-legacy`
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_ANON_KEY=
# Integration tests (go test ./...) run only when this is set
TEST_DATABASE_URL=
